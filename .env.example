# ============================================
# TimeHub Backend - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# ============================================

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development
# Options: development | staging | production

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3001
# Backend server port

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
# Database host (localhost for local, mysql for Docker)

DB_PORT=3306
# MySQL port

DB_NAME=timehub_db
# Database name

DB_USER=admin
# Database user

DB_PASSWORD=admin123
# Database password (change in production!)

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=seu_secret_super_seguro_min_32_caracteres_aleatorios
# Secret key for JWT signing (min 32 chars, use random)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_REFRESH_SECRET=seu_refresh_secret_super_seguro_min_32_caracteres_aleatorios
# Secret key for refresh tokens (min 32 chars)

JWT_EXPIRATION=24h
# JWT token expiration time

JWT_REFRESH_EXPIRATION=7d
# Refresh token expiration time

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:3000
# Frontend URL for CORS (change in production!)

# ============================================
# ADMIN DEFAULT USER (Created on first run)
# ============================================
ADMIN_NAME=Admin
ADMIN_SURNAME=User
ADMIN_EMAIL=admin@timehub.com
ADMIN_PASSWORD=admin123
# Default admin credentials (change in production!)

# ============================================
# FRONTEND CONFIGURATION
# ============================================
HOST_FE=http://localhost:3000
# Frontend URL for links and redirects

# ============================================
# OPTIONAL: Email Configuration (for future use)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@timehub.com

# ============================================
# OPTIONAL: File Upload Configuration
# ============================================
# MAX_UPLOAD_SIZE=5242880
# UPLOAD_DIR=./uploads

# ============================================
# LOGGING CONFIGURATION
# ============================================
# LOG_LEVEL=info
# Options: error | warn | info | debug

# ============================================
# PRODUCTION NOTES
# ============================================
# - Change all passwords and secrets
# - Use strong, random JWT secrets
# - Set NODE_ENV=production
# - Use environment variables, not this file!
# - Enable HTTPS in production
# - Set CORS_ORIGIN to your actual frontend URL
# - Use strong database password
# ============================================